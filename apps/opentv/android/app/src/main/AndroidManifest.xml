<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The two declarations that decide which devices this is offered to,
         and they are not the same question.

         Touchscreen is optional because a television has none, and an app
         that requires one is filtered off every TV in the store.

         Leanback is optional because there are now two interfaces. It was
         required for exactly one release, when the app had a d-pad layout and
         nothing else and a phone install would have been an interface nobody
         could operate. Both exist now, the app asks UiModeManager which
         machine it is on before the first frame, and either answer leads
         somewhere usable — so the store may offer it to both.

         Note the asymmetry, because it is the thing that is easy to get
         backwards: touchscreen-optional is what gets the app onto
         televisions, and leanback-optional is what keeps it on phones. They
         are opposite questions and neither implies the other. -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- IPTV portals overwhelmingly have no usable TLS — the one probed for
         this project rejects a modern handshake outright — so every stream
         URL is plain http. Android has blocked cleartext by default since
         API 28, and without this every channel fails to open.

         This is a real exposure, not a formality: Xtream embeds the username
         and password in the path of every stream URL, so they travel in the
         clear on each channel change. It is a property of the protocol and
         the provider, not a choice the app makes. -->
    <application
        android:usesCleartextTraffic="true"
        android:label="OpenTV"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/tv_banner">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- Both launchers. LEANBACK_LAUNCHER is the television home
                 screen and LAUNCHER is the phone and tablet one; an app that
                 runs on both needs an entry in both, and an app with only the
                 leanback category simply does not appear on a handset. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
                <category android:name="android.intent.category.LEANBACK_LAUNCHER"/>
            </intent-filter>
            <!-- The handover arrives as a link, not through a camera.
                 The other device shows a QR holding an opentv:// address, and
                 whatever camera app is already on this phone opens it. That
                 is why no scanner is bundled: every scanner package's podspec
                 declares iOS and none declare tvOS, and a television app that
                 cannot be built for one of its two televisions is not a
                 saving — the same wall that put the data directory and the
                 keystore on a hand rolled channel.

                 It also means the lens is never ours. No camera permission is
                 requested, and nothing in this app can see through one. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="opentv" android:host="handover"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
