<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The two declarations that decide which devices this is offered to,
         and they are not the same question.

         Touchscreen is optional because a television has none, and an app
         that requires one is filtered off every TV in the store.

         Leanback is required because this is a television app and nothing
         else. Every screen is laid out for a d-pad at three metres and there
         is no touch target anywhere in it, so a phone install would be an
         interface nobody can operate. Left at required="false" the store
         reads that as "runs anywhere", lists it to phones and tablets, and
         the reviews arrive from people it was never built for. -->
    <uses-feature android:name="android.software.leanback" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- IPTV portals overwhelmingly have no usable TLS — the one probed for
         this project rejects a modern handshake outright — so every stream
         URL is plain http. Android has blocked cleartext by default since
         API 28, and without this every channel fails to open.

         This is a real exposure, not a formality: Xtream embeds the username
         and password in the path of every stream URL, so they travel in the
         clear on each channel change. It is a property of the protocol and
         the provider, not a choice the app makes. -->
    <application
        android:usesCleartextTraffic="true"
        android:label="OpenTV"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/tv_banner">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- Leanback only. The ordinary LAUNCHER category is a phone and
                 tablet home screen entry, and declaring it is the second half
                 of telling the store this runs on handsets.

                 Nothing here needs it: flutter run starts the activity by
                 explicit component, and so does adb am start -n. What it does
                 break is launching by category, so use
                 "am start -n com.anthonyessaye.opentv/.MainActivity" rather
                 than monkey -c android.intent.category.LAUNCHER. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LEANBACK_LAUNCHER"/>
            </intent-filter>
            <!-- The handover arrives as a link, not through a camera.
                 The other device shows a QR holding an opentv:// address, and
                 whatever camera app is already on this phone opens it. That
                 is why no scanner is bundled: every scanner package's podspec
                 declares iOS and none declare tvOS, and a television app that
                 cannot be built for one of its two televisions is not a
                 saving — the same wall that put the data directory and the
                 keystore on a hand rolled channel.

                 It also means the lens is never ours. No camera permission is
                 requested, and nothing in this app can see through one. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="opentv" android:host="handover"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
