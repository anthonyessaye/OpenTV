<?xml version="1.0" encoding="utf-8"?>
<!-- The first frame a viewer sees.

     Drawn as the app's own ground with the mark centred, because the default
     is white: on a television, in a dark room, a white flash before a
     near-black interface is the brightest thing the app ever does. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/opentv_ground" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash" />
    </item>
</layer-list>
