<?xml version="1.0" encoding="utf-8"?>
<!-- Two layers rather than one square.

     Android 8 and later masks the launcher icon to whatever shape the device
     has chosen. Given only a legacy bitmap it shims it onto a white plate
     first, so a black tile with an amber bar arrives as a pale blob with its
     corners cut off. Supplying the pair puts our own ground behind the mask.

     The monochrome layer is what a themed home screen tints; it is the bar
     alone, because a glow re-coloured grey reads as a smudge. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/opentv_ground" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
